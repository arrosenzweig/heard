# Copy this file to .env (in this folder, or the folder above it) and fill in ONE key.
# Never commit your real .env.

# Option A - Claude (recommended). Runs on claude-opus-5-5.
ANTHROPIC_API_KEY=

# Option B - course key via Portkey. Runs on gpt-6-luna.
PORTKEY_API_KEY=

# Option C - your own OpenAI key.
OPENAI_API_KEY=

# Optional overrides
# HEARD_PROVIDER=anthropic        # force a provider: anthropic | portkey | openai
# HEARD_MODEL=claude-opus-5-5     # force a model
# HEARD_SECRET=change-me          # session secret for any deployed instance
